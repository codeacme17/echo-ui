{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "$implement result attestation",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "agent",
    "invocationId",
    "startedAt",
    "finishedAt",
    "briefDigest",
    "commitSha",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "agent": { "const": "$implement" },
    "invocationId": { "type": "string", "minLength": 1 },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "briefDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commitSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command", "status"],
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "status": { "const": "passed" }
        }
      }
    }
  }
}
