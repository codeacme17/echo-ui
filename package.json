{
  "name": "@nafr/echo-ui",
  "version": "1.0.0",
  "description": "A UI library born for WAA",
  "keywords": [
    "echo-ui",
    "component",
    "components",
    "design",
    "framework",
    "react",
    "react-component",
    "ui",
    "web-audio-API",
    "audio-components"
  ],
  "author": "leyoonafr <codeacme17@gmail.com>",
  "homepage": "https://echoui.dev",
  "license": "MIT",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/echo-ui.umd.cjs",
  "module": "dist/packages/main.js",
  "types": "dist/types/packages/main.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "dev:example": "pnpm --filter example dev",
    "build:example": "pnpm --filter example build",
    "typecheck:example": "pnpm --filter example typecheck",
    "preview:example": "pnpm --filter example preview",
    "dev:docs": "island dev docs",
    "prebuild:docs": "node scripts/clean-docs-output.mjs",
    "build:docs": "island build docs && node scripts/copy-docs-entry.mjs",
    "preview:docs": "island start docs",
    "verify": "pnpm typecheck && pnpm typecheck:example && pnpm test && pnpm build:example && pnpm build:docs"
  },
  "devDependencies": {
    "@nextui-org/react": "^2.2.9",
    "@nextui-org/theme": "2.4.5",
    "@testing-library/react": "^14.1.2",
    "@types/d3": "^7.4.3",
    "@types/node": "^20.10.2",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vercel/analytics": "^1.1.2",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "clsx": "^2.0.0",
    "d3": "^7.8.5",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "framer-motion": "^10.16.16",
    "islandjs": "^0.7.31",
    "jsdom": "^23.0.1",
    "lucide-react": "^0.294.0",
    "postcss": "^8.4.31",
    "postcss-import": "^15.1.0",
    "prettier": "^3.1.0",
    "prism-react-renderer": "^2.3.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-live": "^4.1.5",
    "tailwind-merge": "^2.0.0",
    "tailwind-variants": "^0.1.19",
    "tailwindcss": "^3.3.5",
    "tone": "^14.7.77",
    "typescript": "^5.2.2",
    "vite": "^5.0.12",
    "vitest": "^1.0.4"
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "d3": "^7.8.5",
    "tailwind-merge": "^2.0.0",
    "tailwind-variants": "^0.1.19",
    "tone": "^14.7.77"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
